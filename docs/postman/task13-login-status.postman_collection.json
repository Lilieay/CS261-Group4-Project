{
  "info": {
    "name": "CS261 Task13 - Login Status Checker",
    "description": "Collection สำหรับทดสอบตัวตรวจสถานะ Login โดยใช้ placeholder variables ไม่เก็บ password หรือ token จริง",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "username", "value": "<username สำหรับทดสอบ>" },
    { "key": "password", "value": "<password สำหรับทดสอบ>" },
    { "key": "access_token", "value": "<token จาก Login>" }
  ],
  "item": [
    {
      "name": "Login - เตรียม token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "Protected API - ไม่มี token ต้องไม่ผ่าน",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/api/protected/check", "host": ["{{base_url}}"], "path": ["api", "protected", "check"] }
      }
    },
    {
      "name": "Protected API - มี token ต้องผ่าน",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": { "raw": "{{base_url}}/api/protected/check", "host": ["{{base_url}}"], "path": ["api", "protected", "check"] }
      }
    }
  ]
}
